<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>spock-rpg-mapepire</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Language runtime the spec is written in -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.33</version>
            <scope>test</scope>
        </dependency>

        <!-- Testing framework: Specification, @Shared, @Unroll -->
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-core</artifactId>
            <version>2.4-groovy-4.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Mapepire/Db2 client: SqlJob, DaemonServer, QueryOptions, QueryResult -->
        <dependency>
            <groupId>io.github.mapepire-ibmi</groupId>
            <artifactId>mapepire-sdk</artifactId>
            <version>0.1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Runs the spec via the JUnit Platform (Spock registers as a TestEngine) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.14.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Maven core only knows how to compile .java files - this plugin adds Groovy
                compilation, picking up the Groovy version from the org.apache.groovy:groovy
                dependency declared above. testSources is pointed at the project root (rather
                than the src/test/groovy default) since RpgSubprocedureSpec.groovy lives there.
            -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>5.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>addTestSources</goal>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <testSources>
                        <testSource>
                            <directory>${project.basedir}</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </testSource>
                    </testSources>
                </configuration>
            </plugin>

            <!--
                No special configuration needed to run Spock specs: Surefire 3.x auto-detects
                junit-platform-launcher (declared above) on the test classpath and uses its
                JUnit Platform provider automatically.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>

</project>
